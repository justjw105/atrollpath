rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // "Join the Party" newsletter signups. Public visitors may CREATE a
    // subscriber document (shaped exactly like { email, source, createdAt }),
    // but can never read, list, update, or delete any entry — that keeps the
    // full email list private to you (viewable only via the Firebase console
    // or Admin SDK, which bypass these client-facing rules).
    match /subscribers/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() < 50
                    && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // Hidden mini-game leaderboards — one collection per game so a simple
    // orderBy(score desc).limit(10) query needs no composite index. Unlike
    // the newsletter list, these ARE publicly readable (that's the whole
    // point of a leaderboard) but still create-only: nobody can edit or
    // remove an existing entry, including their own, so the board can't be
    // tampered with after the fact. The score ceiling here is a basic
    // sanity check against obviously-forged values, not real anti-cheat —
    // genuine tamper-proofing would need a server (Cloud Function) that
    // re-simulates/validates the run itself.
    match /leaderboard_fireflies/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 24
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 500
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /leaderboard_dragon_run/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 24
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 20000
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
